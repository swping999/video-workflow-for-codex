{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swping999/video-workflow-for-codex/content-plan.schema.json",
  "title": "Video Workflow content plan",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {"const": 1},
    "title": {"type": "string"},
    "type": {"enum": ["explainer", "listicle", "workflow", "comparison", "promo", "data-story"]},
    "classification": {"type": "object"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "url": {"type": ["string", "null"], "format": "uri"},
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "kind": {"enum": ["fact", "metric", "testimonial", "capability"]},
          "sourceId": {"type": ["string", "null"]},
          "verified": {"type": "boolean"}
        }
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {"type": ["string", "null"]},
        "logo": {"type": ["string", "null"]},
        "colors": {"type": "array", "items": {"type": "string"}},
        "fonts": {"type": "array", "items": {"type": "string"}},
        "cta": {"type": ["string", "null"]}
      }
    },
    "pronunciation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["match", "spoken"],
        "properties": {"match": {"type": "string"}, "spoken": {"type": "string"}}
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "music": {"type": ["object", "string", "null"]},
        "sfx": {"type": "array", "items": {"type": "object", "required": ["file"]}}
      }
    },
    "comparison": {"$ref": "#/$defs/comparison"},
    "chart": {"$ref": "#/$defs/chart"},
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "narration": {"type": "string"},
          "title": {"type": "string"},
          "chapter": {"type": "string"},
          "type": {"enum": ["explainer", "listicle", "workflow", "comparison", "promo", "data-story"]},
          "asset": {"type": ["string", "null"]},
          "icon": {"type": ["string", "null"]},
          "visual": {"type": "object", "required": ["kind"]},
          "comparison": {"$ref": "#/$defs/comparison"},
          "chart": {"$ref": "#/$defs/chart"}
        }
      }
    }
  },
  "$defs": {
    "comparison": {
      "type": "object",
      "required": ["subjects", "dimensions"],
      "properties": {
        "mode": {"enum": ["comparison-table", "before-after", "tradeoff", "radar", "decision-tree"]},
        "subjects": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "a", "b"],
            "properties": {"name": {"type": "string"}, "a": {}, "b": {}, "max": {"type": "number"}, "winner": {"type": ["string", "null"]}}
          }
        },
        "verdict": {"type": "string"}
      }
    },
    "chart": {
      "type": "object",
      "required": ["labels", "values"],
      "properties": {
        "type": {"enum": ["bar", "line", "area", "ranking"]},
        "labels": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "values": {"type": "array", "minItems": 1, "items": {"type": ["number", "null"]}},
        "unit": {"type": "string"},
        "sourceId": {"type": "string"},
        "source": {"type": "string"},
        "illustrative": {"type": "boolean"},
        "range": {"type": "string"},
        "sort": {"enum": ["asc", "desc"]},
        "scale": {"enum": ["linear", "log"]},
        "domain": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "missing": {"enum": ["error", "skip", "zero", "interpolate"]},
        "annotations": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
